{
  "name": "salaciak-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node --import tsx scripts/sitemap.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ci": "mkdir -p test-results && node --import tsx --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results/unit.xml tests/*.test.ts",
    "ci": "npm run lint && npm run typecheck && npm run test:ci && npm run build && npm run e2e && npm audit --audit-level=high",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "prepare": "cd .. && husky src/.husky"
  },
  "dependencies": {
    "@serwist/next": "9.5.12",
    "@vercel/analytics": "2.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-google-recaptcha": "3.1.0",
    "react-icons": "5.7.0",
    "react-terminal": "1.4.5"
  },
  "devDependencies": {
    "@next/env": "16.3.4",
    "@types/node": "^22.18.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/react-google-recaptcha": "2.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jiti": "^2.6.1",
    "@playwright/test": "^1.55.0",
    "husky": "^9.1.7",
    "msw": "^2.10.5",
    "serwist": "9.5.12",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@serwist/next": {
      "browserslist": "4.28.9"
    }
  }
}
